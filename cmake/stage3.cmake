foreach(scenario RANGE 0 6)
  set(name rtos_logger_${scenario})
  vel_arm_firmware(${name} apps/rtos_data_logger/main.c)
  target_compile_definitions(${name} PRIVATE SCENARIO=${scenario})
  target_link_libraries(${name} PRIVATE fatfs_arm_rtos)
  add_test(NAME logger_${scenario} COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/scripts/run_stage3.py --elf $<TARGET_FILE:${name}> --mode logger${scenario})
  set_tests_properties(logger_${scenario} PROPERTIES TIMEOUT 25)
endforeach()

