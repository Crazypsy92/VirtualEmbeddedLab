find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(RTOS os/freertos/upstream)
add_library(freertos_kernel ${RTOS}/tasks.c ${RTOS}/queue.c ${RTOS}/list.c ${RTOS}/portable/GCC/ARM_CM3/port.c ${RTOS}/portable/MemMang/heap_4.c)
target_include_directories(freertos_kernel PUBLIC ${RTOS}/include ${RTOS}/portable/GCC/ARM_CM3 os/freertos/config)
target_compile_options(freertos_kernel PRIVATE -Wno-conversion -Wno-sign-conversion -Wno-pedantic)
add_compile_options(-mcpu=cortex-m3 -mthumb -Wa,--noexecstack -ffreestanding -fno-builtin -ffunction-sections -fdata-sections)
# Libraries were declared above: set CPU flags explicitly for their compilation too.
target_compile_options(freertos_kernel PRIVATE -mcpu=cortex-m3 -mthumb -Wa,--noexecstack -ffunction-sections -fdata-sections)
function(vel_arm_firmware name source)
  add_executable(${name} ${source} platform/qemu_mps2/freertos/startup.S platform/qemu_mps2/freertos/runtime.c platform/qemu_mps2/drivers/uart.c)
  target_include_directories(${name} PRIVATE platform/qemu_mps2/freertos platform/qemu_mps2/drivers)
  target_link_libraries(${name} PRIVATE freertos_kernel c gcc nosys)
  target_link_options(${name} PRIVATE -mcpu=cortex-m3 -mthumb -nostartfiles -T${CMAKE_SOURCE_DIR}/platform/qemu_mps2/freertos/rtos.ld -Wl,-z,noexecstack,--gc-sections,--fatal-warnings,-Map=${CMAKE_BINARY_DIR}/${name}.map)
  set_target_properties(${name} PROPERTIES SUFFIX ".elf" LINK_DEPENDS ${CMAKE_SOURCE_DIR}/platform/qemu_mps2/freertos/rtos.ld)
  add_custom_command(TARGET ${name} POST_BUILD COMMAND ${CMAKE_OBJCOPY} -O binary $<TARGET_FILE:${name}> ${CMAKE_BINARY_DIR}/${name}.bin COMMAND ${CMAKE_SIZE} $<TARGET_FILE:${name}>)
endfunction()
