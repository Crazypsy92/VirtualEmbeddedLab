option(VEL_STAGE2 "Build Host storage and FatFs tests" ON)
option(VEL_SANITIZE "Enable address and undefined behavior sanitizers" OFF)
if(VEL_STAGE2)
  if(VEL_SANITIZE)
    add_compile_options(-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
    add_link_options(-fsanitize=address,undefined -fno-sanitize-recover=all)
    target_compile_options(host_smoke PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
    target_link_options(host_smoke PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
  endif()
  add_library(block_device src/block_device/block_device.c platform/host/storage/host_storage.c)
  target_compile_definitions(block_device PRIVATE _FILE_OFFSET_BITS=64)
  target_include_directories(block_device PUBLIC include platform/host/storage)
  add_executable(block_tests tests/block_device/block_tests.c)
  target_link_libraries(block_tests PRIVATE block_device)
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  foreach(case IN ITEMS basic geometry persistence faults safety)
    add_test(NAME block_${case} COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/scripts/storage_case.py --exe $<TARGET_FILE:block_tests> --case ${case} --root ${CMAKE_BINARY_DIR}/storage-tests)
    set_tests_properties(block_${case} PROPERTIES TIMEOUT 20 LABELS "Stage2;BlockDevice")
  endforeach()
  add_library(fatfs_upstream middleware/fatfs/upstream/ff.c)
  target_include_directories(fatfs_upstream PUBLIC middleware/fatfs/port middleware/fatfs/upstream)
  # Upstream integer idioms are kept unchanged; our HAL/port/tests retain conversion warnings.
  target_compile_options(fatfs_upstream PRIVATE -Wno-conversion -Wno-sign-conversion -funsigned-char)
  add_library(fatfs_port middleware/fatfs/port/diskio.c)
  target_link_libraries(fatfs_port PUBLIC fatfs_upstream block_device)
  add_executable(fatfs_demo apps/fatfs_demo/main.c)
  target_link_libraries(fatfs_demo PRIVATE fatfs_port)
  add_executable(fatfs_tests tests/fatfs/fatfs_tests.c)
  target_link_libraries(fatfs_tests PRIVATE fatfs_port)
  foreach(case IN ITEMS format fileio directory remount diskio cross-process write-fault sync-fault readonly truncate corrupt crash stress)
    add_test(NAME fatfs_${case} COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/scripts/storage_case.py --exe $<TARGET_FILE:fatfs_tests> --case ${case} --root ${CMAKE_BINARY_DIR}/storage-tests)
    set_tests_properties(fatfs_${case} PROPERTIES TIMEOUT 30 LABELS "Stage2;FatFs")
  endforeach()
  add_test(NAME fatfs_provenance COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/scripts/verify_fatfs.py)
  set_tests_properties(fatfs_provenance PROPERTIES TIMEOUT 20 LABELS "Stage2;Provenance")
endif()
