{
  "version": 3,
  "configurePresets": [
    {
      "name": "host-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "arm-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VEL_ARM": "ON"
      }
    },
    {
      "name": "host-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-sanitize",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VEL_SANITIZE": "ON"
      }
    },
    {
      "name": "freertos-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/freertos",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VEL_FREERTOS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "arm-debug",
      "configurePreset": "arm-debug"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "host-sanitize",
      "configurePreset": "host-sanitize"
    },
    {
      "name": "freertos-debug",
      "configurePreset": "freertos-debug"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "arm-debug",
      "configurePreset": "arm-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-sanitize",
      "configurePreset": "host-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "freertos-debug",
      "configurePreset": "freertos-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
